{
  "name": "@notice-exorcist/notice-extract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "test": "vitest run --root ../.. packages/notice-extract --exclude 'packages/notice-extract/src/live/**'",
    "ollama:start": "systemctl --user start ollama",
    "eval:fixture": "EXTRACT_MODE=fixture bun run eval/run-eval.ts --mode fixture",
    "eval:results": "EXTRACT_MODE=fixture bun run eval/run-eval.ts --mode fixture --write",
    "eval:live": "bun run ollama:start && bun run src/live/wait.ts && EXTRACT_LIVE=require EXTRACT_MODE=record EXTRACT_TIMEOUT_MS=900000 bun run eval/run-eval.ts --mode live",
    "test:live": "bun run ollama:start && bun run src/live/wait.ts && EXTRACT_LIVE=require EXTRACT_TIMEOUT_MS=900000 vitest run src/live"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  }
}
