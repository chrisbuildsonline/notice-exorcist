{
  "name": "notice-exorcist",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "test": "vitest run && bun run --cwd packages/tariff-data test",
    "typecheck": "tsc -p . && tsc -p packages/tariff-data && bun run --cwd apps/web typecheck",
    "e2e": "playwright test",
    "rates:sweep": "vitest run packages/duty-engine/src/rate-text-sweep.test.ts --silent=false"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
