{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages", "e2e", "test","vitest.config.ts", "playwright.config.ts", "playwright.docker.config.ts"],
  "exclude": ["packages/tariff-data", "packages/tariff-mcp"]
}
